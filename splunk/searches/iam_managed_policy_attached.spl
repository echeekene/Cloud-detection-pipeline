index=cloud_detection_lab sourcetype=cloud_detection_json_utc
| search project="cloud_detection" sample_kind="live"
| eval event_key=coalesce(account_id,"unknown").":".event_id
| dedup dataset_id sample_kind event_key
| search event_source="iam.amazonaws.com" event_name="AttachUserPolicy" outcome="success"
| eval rule_id="iam-managed-policy-attached", mitre_technique="T1098.003"
| table rule_id mitre_technique event_id event_time principal source_ip event_name
